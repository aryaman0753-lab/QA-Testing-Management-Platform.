# Copy to backend/.env for local (non-Docker) development.

DATABASE_URL=postgresql+psycopg://qahub:qahub_dev_password@localhost:5432/qahub
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ENVIRONMENT=development
DEBUG=false

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ATTACHMENT_STORAGE_DIR=./storage/attachments
MAX_ATTACHMENT_SIZE_MB=10
API_REQUEST_TIMEOUT_SECONDS=30
API_MAX_TIMEOUT_SECONDS=60
API_MAX_RESPONSE_SIZE_MB=5
API_RESPONSE_BODY_RETENTION_BYTES=262144
API_MAX_REDIRECTS=5
API_EXECUTIONS_PER_MINUTE=30
API_ALLOW_PRIVATE_NETWORKS=false
API_ALLOW_INSECURE_SSL=false
# Set independently from JWT_SECRET_KEY in production; rotating it requires re-saving secrets.
SECRET_ENCRYPTION_KEY=
LOAD_TEST_MAX_USERS=100
LOAD_TEST_MAX_DURATION_SECONDS=600
LOAD_TEST_MAX_SPAWN_RATE=20
LOAD_TEST_MAX_TARGET_RPS=500
LOAD_TEST_MAX_CONCURRENT_PER_USER=1
LOAD_TEST_MAX_CONCURRENT_PER_PROJECT=2
LOAD_TEST_MAX_CONCURRENT_RUNS=3
LOAD_TEST_MAX_RESPONSE_SIZE_BYTES=1048576
LOAD_TEST_ALLOW_PRIVATE_NETWORKS=false
LOAD_TEST_ALLOW_PRODUCTION=false
LOAD_TEST_PRODUCTION_MAX_USERS=10
LOAD_TEST_PRODUCTION_MAX_DURATION_SECONDS=60
LOAD_TEST_PRODUCTION_MAX_TARGET_RPS=20
LOAD_TEST_REQUIRE_ALLOWLIST=true
LOAD_TEST_ALLOWED_HOSTS=
LOAD_TEST_RESULT_RETENTION_DAYS=
LOAD_TEST_METRICS_INTERVAL_SECONDS=2
LOAD_TEST_STALE_RUN_SECONDS=90
LOAD_TEST_QUEUE_NAME=qahub:load-tests

# Same values must be used by the API, automation-worker, and scheduler-worker.
AUTOMATION_ALLOW_PRODUCTION=false
AUTOMATION_ALLOW_PRIVATE_NETWORKS=false
AUTOMATION_ALLOWED_HOSTS=
AUTOMATION_MAX_CONCURRENT_RUNS=3
AUTOMATION_MAX_CONCURRENT_PER_PROJECT=2
AUTOMATION_MAX_CONCURRENT_PER_USER=1
AUTOMATION_MAX_STEPS=200
AUTOMATION_MAX_CASES=50
AUTOMATION_MAX_RUN_SECONDS=900
AUTOMATION_MAX_DELAY_SECONDS=30
AUTOMATION_MAX_RETRIES=3
AUTOMATION_STALE_RUN_SECONDS=120
AUTOMATION_QUEUE_TIMEOUT_SECONDS=900
AUTOMATION_QUEUE_NAME=qahub:automation
AUTOMATION_SCHEDULER_INTERVAL_SECONDS=5

# Phase 6 operations. Retention values are opt-in; blank means no deletion.
PUBLIC_BASE_URL=http://localhost:5173
CI_API_KEYS_PER_PROJECT=10
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_QUEUE_NAME=qahub:webhooks
WEBHOOK_DELIVERY_RETENTION_DAYS=
AUTOMATION_RESULT_RETENTION_DAYS=
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_UNAVAILABLE_SECONDS=45
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_CI_PER_MINUTE=30
RATE_LIMIT_EXECUTION_PER_MINUTE=20
RATE_LIMIT_WEBHOOK_CONFIG_PER_MINUTE=20
MAX_REQUEST_SIZE_MB=10

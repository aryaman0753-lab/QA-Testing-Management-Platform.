# Copy this file to .env and adjust values for your environment.
# Used by docker-compose.yml and, when running locally, by the backend app.

# --- Postgres (container credentials) ---
POSTGRES_DB=qahub
POSTGRES_USER=qahub
POSTGRES_PASSWORD=qahub_dev_password

# --- Backend ---
# When running via docker-compose, host "db" and "redis" resolve to the containers.
DATABASE_URL=postgresql+psycopg://qahub:qahub_dev_password@db:5432/qahub
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ENVIRONMENT=development
DEBUG=false

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ATTACHMENT_STORAGE_DIR=/app/storage/attachments
MAX_ATTACHMENT_SIZE_MB=10

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
